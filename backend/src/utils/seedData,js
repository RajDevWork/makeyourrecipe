const seedDatabase = async () => {
  try {
    console.log('🌱 Starting database seeding...');
    
    await mongoose.connect(process.env.MONGODB_URI);
    console.log('✅ Connected to MongoDB');

    // Clear existing data
    await User.deleteMany({});
    await Category.deleteMany({});
    await Recipe.deleteMany({});
    console.log('🗑️ Cleared existing data');

    // Create categories
    const createdCategories = await Category.insertMany(categories);
    console.log(`✅ Created ${createdCategories.length} categories`);

    // Hash password
    const hashedPassword = await bcrypt.hash('Password123!', 12);

    // Create admin user
    const admin = await User.create({
      name: 'Admin User',
      email: 'admin@recipebook.com',
      password: hashedPassword,
      role: 'admin',
      isEmailVerified: true,
      isActive: true,
      bio: 'Platform administrator and food enthusiast',
      avatar: 'https://ui-avatars.com/api/?name=Admin+User&background=0D8F81&color=fff',
    });

    // Create regular users
    const users = await User.insertMany([
      {
        name: 'Sarah Johnson',
        email: 'sarah@example.com',
        password: hashedPassword,
        role: 'user',
        isEmailVerified: true,
        isActive: true,
        bio: 'Home cook and recipe developer',
        avatar: 'https://ui-avatars.com/api/?name=Sarah+Johnson&background=FF6B6B&color=fff',
        stats: { totalRecipes: 3, totalLikes: 45, totalFollowers: 12, totalFollowing: 8 },
      },
      {
        name: 'Michael Chen',
        email: 'michael@example.com',
        password: hashedPassword,
        role: 'user',
        isEmailVerified: true,
        isActive: true,
        bio: 'Professional chef sharing my recipes',
        avatar: 'https://ui-avatars.com/api/?name=Michael+Chen&background=4ECDC4&color=fff',
        stats: { totalRecipes: 5, totalLikes: 128, totalFollowers: 45, totalFollowing: 23 },
      },
      {
        name: 'Emma Wilson',
        email: 'emma@example.com',
        password: hashedPassword,
        role: 'user',
        isEmailVerified: true,
        isActive: true,
        bio: 'Healthy eating advocate',
        avatar: 'https://ui-avatars.com/api/?name=Emma+Wilson&background=FFE66D&color=333',
        stats: { totalRecipes: 2, totalLikes: 32, totalFollowers: 8, totalFollowing: 15 },
      },
    ]);
    console.log(`✅ Created ${users.length + 1} users`);

    // Create recipes
    const allUsers = [admin, ...users];
    const createdRecipes = [];
    
    for (let i = 0; i < recipes.length; i++) {
      const recipe = recipes[i];
      const randomUser = allUsers[Math.floor(Math.random() * allUsers.length)];
      const randomCategory = createdCategories[Math.floor(Math.random() * createdCategories.length)];
      
      const newRecipe = await Recipe.create({
        ...recipe,
        author: randomUser._id,
        category: randomCategory._id,
        status: 'published',
        'stats.views': Math.floor(Math.random() * 1000) + 100,
        'stats.likes': Math.floor(Math.random() * 100) + 10,
        'stats.saves': Math.floor(Math.random() * 50) + 5,
      });
      
      createdRecipes.push(newRecipe);
      
      // Update user's total recipes count
      await User.findByIdAndUpdate(randomUser._id, {
        $inc: { 'stats.totalRecipes': 1 }
      });
      
      // Update category recipe count
      await Category.findByIdAndUpdate(randomCategory._id, {
        $inc: { recipeCount: 1 }
      });
    }
    
    console.log(`✅ Created ${createdRecipes.length} recipes`);

    console.log('\n🎉 Database seeding completed successfully!');
    console.log('\n📝 Login credentials:');
    console.log('Admin - Email: admin@recipebook.com, Password: Password123!');
    console.log('User  - Email: sarah@example.com, Password: Password123!');
    console.log('User  - Email: michael@example.com, Password: Password123!');
    console.log('User  - Email: emma@example.com, Password: Password123!');
    
    process.exit(0);
  } catch (error) {
    console.error('❌ Error seeding database:', error);
    process.exit(1);
  }
};

